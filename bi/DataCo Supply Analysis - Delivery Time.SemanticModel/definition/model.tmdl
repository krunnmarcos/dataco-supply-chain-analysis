model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["PastaDados", "fVendas", "dCategoria", "dProduto", "dCliente", "dLocalSaida", "dLocalEntrega", "dTipoEntrega"]

ref table fVendas
ref table dCategoria
ref table dProduto
ref table dCliente
ref table dLocalSaida
ref table dLocalEntrega
ref table dTipoEntrega
ref table Calendario
ref table _Medidas

ref cultureInfo pt-BR

